# ~/.gitconfig — paquete "git" (complemento de Omarchy).
#
# Omarchy ya instala ~/.config/git/config con la identidad, los aliases base y
# los ajustes generales. Git lee ambos archivos y este ~/.gitconfig tiene la
# última palabra, así que acá solo van preferencias personales que Omarchy no
# define. No repitas los ajustes de Omarchy.
#
# - Identidad y ajustes por equipo: ~/.gitconfig.local (no versionado).
# - delta es opcional: paquete "git-delta" y se incluye más abajo.
# - $EDITOR/$VISUAL los define Omarchy; este archivo no los toca.

[core]
	autocrlf = input
	whitespace = -indent-with-non-tab,trailing-space,cr-at-eol
	excludesfile = ~/.gitignore_global

[init]
	# Preferencia personal; Omarchy usa "master".
	defaultBranch = main

[help]
	autocorrect = prompt

[fetch]
	prune = true
	pruneTags = true

[push]
	followTags = true

[rebase]
	autoStash = true
	updateRefs = true

[merge]
	conflictstyle = zdiff3

# Omarchy apunta el helper a una ruta versionada de mise; `gh` en PATH es más
# estable entre actualizaciones. Si preferís el helper de Omarchy, borrá este bloque.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[alias]
	# Estado
	s = status -sb
	aa = add --all

	# Navegación
	sw = switch

	# Commits (ojo: wip agrega TODO con add -A)
	amend = commit --amend
	wip = !git add -A && git commit -m "WIP"

	# Diff
	df = diff
	dc = diff --cached

	# Historial
	lg = log --graph --abbrev-commit --decorate --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
	last = log -1 HEAD --stat
	contributors = shortlog -sn

	# Sincronización (Omarchy ya configura pull.rebase y push.autoSetupRemote)
	up = pull
	publish = push -u origin HEAD

	# Stash
	ss = stash push
	sl = stash list
	sp = stash pop

	# Utilidades (ojo: discard descarta cambios sin commitear, sin vuelta atrás)
	undo = reset --mixed HEAD~1
	unstage = restore --staged .
	discard = restore .

# Git ignora sin error los includes cuya ruta no existe.
[include]
	path = ~/.config/git/delta.gitconfig
	path = ~/.gitconfig.local

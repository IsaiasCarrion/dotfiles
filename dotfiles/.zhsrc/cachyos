# Python and PyPI Functions
_pypi_search_install() {
	local tool="$1"
	local query="$2"
	local prompt_text="$3"

	for cmd in "$tool" fzf curl jq; do
		command -v "$cmd" >/dev/null || {
			echo "Error: '$cmd' is not installed." >&2
			return 1
		}
	done

	local selection
	selection=$(curl -s "https://pypi.org/simple/" |
		sed -E 's|<a href=.*>(.*)</a>|\1|' | sort -u |
		fzf --multi --query="$query" --prompt="$prompt_text" --preview='
      curl -s https://pypi.org/pypi/{}/json | jq -r ".info | \"Name: \(.name)\nVersion: \(.version)\nSummary: \(.summary)\nHome Page: \(.home_page)\"" 2>/dev/null
    ')

	if [ -n "$selection" ]; then
		echo "$selection" | xargs -r -n1 "$tool" install
	fi
}

## Wrapper's with pypi_search_install
npip() {
	_pypi_search_install "pip" "${1:-}" "PyPI > "
}
npipx() {
	_pypi_search_install "pipx" "${1:-}" "PyPI (pipx) > "
}

# Virtual Environment (Venv) Functions

## Activate Python virtual environments (improved logic)
function v() {

	if [ -n "$1" ]; then
		local VENV_PATH="$HOME/venvs/$1"
		if [ -f "$VENV_PATH/bin/activate" ]; then
			echo "Activating environment: $VENV_PATH"
			source "$VENV_PATH/bin/activate"
			return 0
		else
			echo "Error: Environment not found at: $VENV_PATH" >&2
			return 1
		fi
	fi

	for local_env in "venv" ".venv"; do
		if [ -f "$local_env/bin/activate" ]; then
			echo "Activating local environment: $local_env"
			source "$local_env/bin/activate"
			return 0
		fi
	done

	echo "Error: No virtual environment found." >&2
	echo "Usage: v [env_name] (for ~/venvs) or 'v' (for ./venv)" >&2
	return 1
}

## Create virtual environment in ~/venvs/ (more robust)
function mkvenv() {
	if [ -z "$1" ]; then
		echo "Usage: mkvenv <name>" >&2
		return 1
	fi

	local VENV_PATH="$HOME/venvs/$1"

	# Added check to avoid overwriting
	if [ -d "$VENV_PATH" ]; then
		echo "Error: Environment '$1' already exists at $VENV_PATH" >&2
		return 1
	fi

	echo "Creating environment '$1' at $VENV_PATH..."
	python3 -m venv "$VENV_PATH" && echo "Environment '$1' created successfully!"
}

# Git Function

## Automates the git add, commit, and push flow (improved prompt)
function gpush() {
	if [ -z "$1" ]; then
		echo "Error: You must provide a commit message." >&2
		echo "Usage: gpush \"Your commit message\"" >&2
		return 1
	fi

	echo "Adding all modified files with 'git add --all'..."
	git add --all

	echo "Committing with message: '$1'"
	git commit -m "$1"

	# Commit error check
	if [ $? -ne 0 ]; then
		echo "Commit failed. Push will not be performed." >&2
		return 1
	fi

	echo "\nSummary of changes to be pushed:"
	git --no-pager log -1 --stat

	# Native Zsh confirmation prompt (waits for y/n key)
	read -q "reply?Are you sure you want to 'git push'? (y/n): "
	echo # Adds a newline after the keypress

	if [[ $reply =~ ^[Yy]$ ]]; then
		echo "Performing 'git push'..."
		git push
	else
		echo "Operation cancelled. Push was not performed."
	fi
}


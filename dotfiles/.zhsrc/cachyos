# ---| Funciones de Python y PyPI |---

# Función auxiliar (helper) para buscar e instalar desde PyPI
# Evita repetir código (Principio DRY)
_pypi_search_install() {
  local tool="$1"   # 'pip' o 'pipx'
  local query="$2"
  local prompt_text="$3"

  # Verificar dependencias
  for cmd in "$tool" fzf curl jq; do
    command -v "$cmd" >/dev/null || {
      echo "Error: '$cmd' no está instalado." >&2
      return 1
    }
  done

  # Obtener selección desde fzf
  local selection
  selection=$(curl -s "https://pypi.org/simple/" | \
    sed -E 's|<a href=.*>(.*)</a>|\1|' | sort -u | \
    fzf --multi --query="$query" --prompt="$prompt_text" --preview='
      curl -s https://pypi.org/pypi/{}/json | jq -r ".info | \"Name: \(.name)\nVersion: \(.version)\nSummary: \(.summary)\nHome Page: \(.home_page)\"" 2>/dev/null
    ')

  # Instalar si la selección no está vacía
  if [ -n "$selection" ]; then
    echo "$selection" | xargs -r -n1 "$tool" install
  fi
}

# Funciones públicas que usan el helper
npip() {
  _pypi_search_install "pip" "${1:-}" "PyPI > "
}
npipx() {
  _pypi_search_install "pipx" "${1:-}" "PyPI (pipx) > "
}


# ---| Funciones de Entornos Virtuales (Venv) |---

# Activar entornos virtuales de Python (lógica mejorada)
function v() {
  # Caso 1: Activar un entorno específico desde ~/venvs
  if [ -n "$1" ]; then
    local VENV_PATH="$HOME/venvs/$1"
    if [ -f "$VENV_PATH/bin/activate" ]; then
      echo "Activando entorno: $VENV_PATH"
      source "$VENV_PATH/bin/activate"
      return 0
    else
      echo "Error: No se encontró entorno en: $VENV_PATH" >&2
      return 1
    fi
  fi

  # Caso 2: Sin argumento, buscar un entorno local (./venv o ./.venv)
  for local_env in "venv" ".venv"; do
    if [ -f "$local_env/bin/activate" ]; then
      echo "Activando entorno local: $local_env"
      source "$local_env/bin/activate"
      return 0
    fi
  done

  # Caso 3: No se encontró nada
  echo "Error: No se encontró un entorno virtual." >&2
  echo "Uso: v [nombre_entorno] (para ~/venvs) ó 'v' (para ./venv)" >&2
  return 1
}

# Crear entorno virtual en ~/venvs/ (más robusto)
function mkvenv() {
  if [ -z "$1" ]; then
    echo "Uso: mkvenv <nombre>" >&2
    return 1
  fi

  local VENV_PATH="$HOME/venvs/$1"

  # Añadida verificación para no sobrescribir
  if [ -d "$VENV_PATH" ]; then
    echo "Error: El entorno '$1' ya existe en $VENV_PATH" >&2
    return 1
  fi

  echo "Creando entorno '$1' en $VENV_PATH..."
  python3 -m venv "$VENV_PATH" && echo "¡Entorno '$1' creado exitosamente!"
}


# ---| Función de Git |---

# Automatiza el flujo de git add, commit y push (prompt mejorado)
function gpush() {
  if [ -z "$1" ]; then
    echo "Error: Debes proporcionar un mensaje de commit." >&2
    echo "Uso: gpush \"Tu mensaje de commit\"" >&2
    return 1
  fi

  echo "Añadiendo todos los archivos modificados con 'git add --all'..."
  git add --all

  echo "Realizando commit con el mensaje: '$1'"
  git commit -m "$1"

  # Verificación de error de commit
  if [ $? -ne 0 ]; then
    echo "El commit falló. No se realizará el push." >&2
    return 1
  fi

  echo "\nResumen de los cambios a subir:"
  git --no-pager log -1 --stat

  # Prompt de confirmación nativo de Zsh (espera una tecla y/n)
  read -q "reply?¿Estás seguro de que quieres hacer 'git push'? (y/n): "
  echo # Añade un salto de línea después de la tecla

  if [[ $reply =~ ^[Yy]$ ]]; then
    echo "Realizando 'git push'..."
    git push
  else
    echo "Operación cancelada. No se realizó el push."
  fi
}



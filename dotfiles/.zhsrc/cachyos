# Activar entornos virtuales (local o desde ~/venvs)
function v() {
  # Activar un entorno específico de ~/venvs
  if [ -n "$1" ]; then
    local VENV_PATH="$HOME/venvs/$1"
    if [ -f "$VENV_PATH/bin/activate" ]; then
      echo "Activating environment: $VENV_PATH"
      source "$VENV_PATH/bin/activate"
      return 0
    else
      echo "Error: Environment not found at: $VENV_PATH" >&2
      return 1
    fi
  fi

  # Sin argumento, buscar localmente (./venv o ./.venv)
  for local_env in "venv" ".venv"; do
    if [ -f "$local_env/bin/activate" ]; then
      echo "Activating local environment: $local_env"
      source "$local_env/bin/activate"
      return 0
    fi
  done

  # No se encontró nada
  echo "Error: No virtual environment found." >&2
  echo "Usage: v [env_name] (for ~/venvs) or 'v' (for ./venv)" >&2
  return 1
}

# Crear virtual environment en ~/venvs/ (Usando UV)
function mkvenv() {
  if [ -z "$1" ]; then
    echo "Usage: mkvenv <name>" >&2
    return 1
  fi

  local VENV_PATH="$HOME/venvs/$1"

  if [ -d "$VENV_PATH" ]; then
    echo "Error: Environment '$1' already exists at $VENV_PATH" >&2
    return 1
  fi

  echo "Creating environment '$1' with uv at $VENV_PATH..."
  uv venv "$VENV_PATH" && echo "Environment '$1' created successfully!"
  echo "Activate with: v $1"
}


# ---| Gestor de Paquetes UV |---

# Instalar paquetes (reemplaza 'pip install')
function uvi() {
  if [ -z "$1" ]; then echo "Usage: uvi <pkg...>" >&2; return 1; fi
  echo "Installing $@ with uv..."
  uv pip install "$@"
}

# Desinstalar paquetes (reemplaza 'pip uninstall')
function uvu() {
  if [ -z "$1" ]; then echo "Usage: uvu <pkg...>" >&2; return 1; fi
  echo "Uninstalling $@ with uv..."
  uv pip uninstall "$@"
}

# Sincronizar (reemplaza 'pip install -r')
function uvs() {
  local req_file="${1:-requirements.txt}"
  if [ ! -f "$req_file" ]; then echo "Error: $req_file not found." >&2; return 1; fi
  echo "Syncing environment with $req_file ..."
  uv pip sync "$req_file"
}

# Listar/Congelar (reemplaza 'pip freeze')
function uvf() {
  uv pip freeze
}


# ---| Herramientas Globales UV (Reemplazo de Pipx) |---

# Instalar herramienta (reemplaza 'pipx install')
function uvx() {
  if [ -z "$1" ]; then echo "Usage: uvx <pkg>" >&2; return 1; fi
  echo "Installing global tool $@ with uv..."
  uv tool install "$@"
}

# Ejecutar herramienta (reemplaza 'pipx run')
function uvr() {
  if [ -z "$1" ]; then echo "Usage: uvr <pkg> [args...]" >&2; return 1; fi
  echo "Running $@ with uv..."
  uv tool run "$@"
}

# Listar herramientas (reemplaza 'pipx list')
function uvl() {
  echo "UV Global Tools:"
  uv tool list
}

# Desinstalar herramienta (reemplaza 'pipx uninstall')
function uvux() {
  if [ -z "$1" ]; then echo "Usage: uvux <pkg>" >&2; return 1; fi
  echo "Uninstalling global tool $@ with uv..."
  uv tool uninstall "$@"
}

# ---| Git Function |---

# Automates the git add, commit, and push flow (improved prompt)
function gpush() {
  if [ -z "$1" ]; then
    echo "Error: You must provide a commit message." >&2
    echo "Usage: gpush \"Your commit message\"" >&2
    return 1
  fi

  echo "Adding all modified files with 'git add --all'..."
  git add --all

  echo "Committing with message: '$1'"
  git commit -m "$1"

  # Commit error check
  if [ $? -ne 0 ]; then
    echo "Commit failed. Push will not be performed." >&2
    return 1
  fi

  echo "\nSummary of changes to be pushed:"
  git --no-pager log -1 --stat

  # Native Zsh confirmation prompt (waits for y/n key)
  read -q "reply?Are you sure you want to 'git push'? (y/n): "
  echo # Adds a newline after the keypress

  if [[ $reply =~ ^[Yy]$ ]]; then
    echo "Performing 'git push'..."
    git push
  else
    echo "Operation cancelled. Push was not performed."
  fi
}



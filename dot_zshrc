# ------------------------------------------------------------------------------
## 📦 CachyOS Package Browser
# ------------------------------------------------------------------------------

function pacs() {
    local -a repos
    local pkg

    repos=(
        $(pacman-conf --repo-list | grep '^cachyos')
    )

    pkg=$(
        pacman -Slq "${repos[@]}" |
            sort -u |
            fzf \
                --multi \
                --ansi \
                --height=80% \
                --layout=reverse \
                --border \
                --prompt='📦 CachyOS > ' \
                --preview '
        pacman -Si {} 2>/dev/null

        echo
        echo "────────────────────────"

        pacman -Fl {} 2>/dev/null | head -200
      ' \
                --preview-window=right:70%
    ) || return

    sudo pacman -S $pkg
}

# ------------------------------------------------------------------------------
## 🗑️ Remove Installed Packages (Interactive)
# ------------------------------------------------------------------------------

function pacrm() {
    local pkgs

    pkgs=$(
        pacman -Qq |
            fzf \
                --multi \
                --ansi \
                --height=80% \
                --layout=reverse \
                --border \
                --prompt='🗑️ Remove > ' \
                --preview '
        pacman -Qi {} 2>/dev/null

        echo
        echo "────────────────────────"

        pactree -r {} 2>/dev/null | head -50
      ' \
                --preview-window=right:70%
    ) || return

    echo
    echo "Packages selected:"
    echo "$pkgs"
    echo

    read -q "REPLY?Remove selected packages? [y/N]: "
    echo

    [[ "$REPLY" =~ ^[Yy]$ ]] || return

    sudo pacman -Rns $pkgs
}

# ------------------------------------------------------------------------------
## 🐍 Python Packages Browser
# ------------------------------------------------------------------------------

function pypacs() {
    local pkg

    pkg=$(
        curl -s https://pypi.org/simple/ |
            sed -E 's/<[^>]+>//g' |
            sed '/^\s*$/d' |
            fzf \
                --height=80% \
                --layout=reverse \
                --border \
                --prompt='🐍 ' \
                --preview '
        curl -s https://pypi.org/pypi/{}/json |
        jq -r "
          .info.name,
          \"\",
          \"Version: \(.info.version)\",
          \"\",
          .info.summary,
          \"\",
          \"Home: \(.info.home_page)\",
          \"\",
          .info.author
        "
      ' \
                --preview-window=right:60%
    ) || return

    echo "Installing: $pkg"

    if command -v uv &>/dev/null; then
        uv pip install "$pkg"
    else
        pip install "$pkg"
    fi
}


        fzf-preview 'eza --tree --level=2 --icons --color=always $realpath'

    zstyle ':fzf-tab:complete:*:*' \
        fzf-preview 'bat --color=always --style=numbers --line-range=:300 ${realpath#--*=} 2>/dev/null'

    zstyle ':fzf-tab:complete:kill:*' \

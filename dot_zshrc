# ==============================================================================
# 🚀 ZSH CONFIG — CACHYOS POWER USER EDITION
# ==============================================================================
# Filosofía:
#
# 1. CORE
#    Variables, historial, shell options, completion.
#
# 2. ALWAYS LOADED
#    Starship, zoxide, syntax highlight, autosuggestions.
#
# 3. LAZY / CONDITIONAL
#    Docker, uv, atuin, previews, fzf integrations.
#
# 4. PERFORMANCE
#    Fast compinit
#    Lazy checks
#    Conditional binaries
#    Minimal subshells
#
# ==============================================================================

# ==============================================================================
## 🧠 CORE ENV
# ==============================================================================

export SHELL="$(command -v zsh)"
export EDITOR="zeditor"
export VISUAL="$EDITOR"

# Cache
typeset -g ZCACHE="${HOME}/.cache/zsh"
typeset -g compfile="${ZCACHE}/.zcompdump"
typeset -g HISTFILE="${ZCACHE}/history"

mkdir -p "$ZCACHE"

# History
HISTSIZE=100000
SAVEHIST=100000

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_VERIFY
setopt EXTENDED_HISTORY

# Shell behavior
setopt AUTO_CD
setopt AUTO_CONTINUE
setopt COMPLETE_IN_WORD
setopt ALWAYS_TO_END
setopt INTERACTIVE_COMMENTS
setopt EXTENDED_GLOB
setopt GLOB_COMPLETE
setopt NO_NOMATCH
setopt LIST_PACKED
setopt TRANSIENT_RPROMPT

KEYTIMEOUT=1

# Disable flow control
stty -ixon

# ==============================================================================
## ⚡ FAST COMPINIT
# ==============================================================================

autoload -Uz compinit

if [[ ! -f "$compfile" || $(find "$compfile" -mtime +1 2>/dev/null) ]]; then
    compinit -u -d "$compfile"
else
    compinit -C -u -d "$compfile"
fi

zmodload -i zsh/complist

# ==============================================================================
## 🎨 COMPLETION STYLES
# ==============================================================================

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$ZCACHE"
zstyle ':completion:*' menu select
zstyle ':completion:*' verbose true
zstyle ':completion:*' insert-tab false
zstyle ':completion:*' group-name ''
zstyle ':completion:*' squeeze-slashes true

zstyle ':completion:*' matcher-list \
    'm:{a-zA-Z}={A-Za-z}' \
    'r:|[._-]=* r:|=*' \
    'l:|=* r:|=*'

zstyle ':completion:*' completer \
    _complete \
    _match \
    _approximate \
    _ignored

zstyle ':completion:*:descriptions' format ' %F{green}→ %d%f'
zstyle ':completion:*:warnings' format ' %F{red}no matches%f'


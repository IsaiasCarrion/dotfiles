# ------------------------------------------------------------------------------
## 🐍 Python Venvs
# ------------------------------------------------------------------------------

function v() {
    if [[ -n "$1" ]]; then
        local venv="${HOME}/venvs/$1"

        if [[ -f "$venv/bin/activate" ]]; then
            source "$venv/bin/activate"
            return
        fi

        echo "Environment not found: $1"
        return 1
    fi

    for env in venv .venv; do
        if [[ -f "$env/bin/activate" ]]; then
            source "$env/bin/activate"
            return
        fi
    done

    echo "No virtual environment found."
}

function mkvenv() {
    [[ -z "$1" ]] && {
        echo "Usage: mkvenv <name>"
        return 1
    }

    local target="${HOME}/venvs/$1"

    [[ -d "$target" ]] && {
        echo "Already exists."
        return 1
    }

    uv venv "$target"
}

# ------------------------------------------------------------------------------
## 📦 UV
# ------------------------------------------------------------------------------

function _uv_run() {
    local cmd="$1"
    shift

    (($# == 0)) && {
        echo "Usage: uv${cmd} <package>"
        return 1
    }

    uv pip "$cmd" "$@"
}

function uvi() { _uv_run install "$@"; }
function uvu() { _uv_run uninstall "$@"; }
function uvf() { uv pip freeze; }

function uvs() {
    local req="${1:-requirements.txt}"

    [[ ! -f "$req" ]] && {
        echo "requirements not found"
        return 1
    }

    uv pip sync "$req"
}

function uvx() { uv tool install "$@"; }
function uvr() { uv tool run "$@"; }
function uvl() { uv tool list; }
function uvux() { uv tool uninstall "$@"; }

# ------------------------------------------------------------------------------
## 📁 Smart mkdir
# ------------------------------------------------------------------------------

function mkpaths() {
    for item in "$@"; do
        if [[ "$item" == *.* ]]; then
            mkdir -p "$(dirname "$item")"
            touch "$item"
        else
            mkdir -p "$item"
        fi
    done
}

# ------------------------------------------------------------------------------
## 🚀 Git Push
# ------------------------------------------------------------------------------

function gpush() {
    if [[ -z "$1" ]]; then
        echo 'Usage: gpush "mensaje del commit"'
        return 1
    fi

    local branch remote

    branch=$(git branch --show-current)

    if [[ -z "$branch" ]]; then
        echo "❌ No se pudo determinar la rama actual."
        return 1
    fi

    remote=$(git config --get "branch.${branch}.remote")
    remote=${remote:-origin}

    git add --all || return 1

    git commit -m "$1" || {
        echo "❌ Commit cancelado o sin cambios."
        return 1
    }

    echo
    echo "Último commit:"
    git --no-pager log -1 --oneline --stat

    echo
    echo "📍 Rama  : $branch"
    echo "🚀 Remote: $remote"
    echo "🎯 Push a: ${remote}/${branch}"
    echo

    read -q "REPLY?¿Continuar con el push? [y/N]: "
    echo

    if [[ "$REPLY" =~ ^[Yy]$ ]]; then
        git push "$remote" "$branch"
    else
        echo "Push cancelado."
    fi
}

# ------------------------------------------------------------------------------
## 📂 Yazi
# ------------------------------------------------------------------------------

function y() {
    local tmp cwd

    tmp="$(mktemp -t yazi-cwd.XXXXXX)"

    yazi "$@" --cwd-file="$tmp"

    cwd="$(<"$tmp")"

    [[ -n "$cwd" && "$cwd" != "$PWD" ]] && cd "$cwd"

    rm -f "$tmp"
}

# ------------------------------------------------------------------------------
## 📦 Smart Extract
# ------------------------------------------------------------------------------

function extract() {
    if [[ -f "$1" ]]; then
        case "$1" in
        *.tar.bz2) tar xjf "$1" ;;
        *.tar.gz) tar xzf "$1" ;;
        *.bz2) bunzip2 "$1" ;;
        *.rar) unrar x "$1" ;;
        *.gz) gunzip "$1" ;;
        *.tar) tar xf "$1" ;;
        *.tbz2) tar xjf "$1" ;;
        *.tgz) tar xzf "$1" ;;
        *.zip) unzip "$1" ;;
        *.7z) 7z x "$1" ;;
        *) echo "Cannot extract '$1'" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# ------------------------------------------------------------------------------
## ⚡ Zoxide + FZF History
# ------------------------------------------------------------------------------

function zzf() {
    local dir

    dir=$(
        zoxide query -ls |
            fzf \
                --height 50% \
                --layout reverse \
                --prompt="📁 " \
                --preview 'eza --icons --tree --level=2 --color=always {2..}'
    ) || return

    cd "${dir#* }"
}

# Shortcut MUY cómodo
bindkey '^G' zzf


email = [carrionisaias@gmail.com](mailto:carrionisaias@gmail.com)

[core]
editor = zed -w
pager = delta
autocrlf = input
whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
excludesfile = ~/.gitignore_global

[init]
defaultBranch = main

[color]
ui = auto

[help]
autocorrect = prompt

[column]
ui = auto

[fetch]
prune = true
pruneTags = true

[pull]
rebase = true
ff = only

[push]
autoSetupRemote = true
default = simple
followTags = true

[rebase]
autoStash = true
updateRefs = true

[rerere]
enabled = true
autoupdate = true

[merge]
conflictstyle = zdiff3

[diff]
algorithm = histogram
colorMoved = default

[delta]
navigate = true
light = false
side-by-side = true
line-numbers = true
syntax-theme = ansi

[interactive]
diffFilter = delta --color-only

[credential "https://github.com"]
helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
helper = !/usr/bin/gh auth git-credential

[commit]
verbose = true

[tag]
sort = version:refname

[alias]

```
; Estado
s = status -sb
st = status
aa = add --all

; Navegación
co = checkout
sw = switch
br = branch

; Commits
ci = commit
amend = commit --amend
wip = !git add -A && git commit -m "WIP"

; Diff
df = diff
dc = diff --cached

; Historial
lg = log --graph --abbrev-commit --decorate --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
last = log -1 HEAD --stat
contributors = shortlog -sn

; Sincronización
up = pull --rebase --autostash
publish = push -u origin HEAD

; Stash
ss = stash push
sl = stash list
sp = stash pop

; Utilidades
undo = reset --mixed HEAD~1
unstage = restore --staged .
discard = restore .

; Limpieza extrema
nuke = !git clean -fdx && git reset --hard HEAD
```

[gpg]
format = ssh

[gpg "ssh"]
program = /usr/bin/ssh-keygen

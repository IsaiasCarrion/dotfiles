{
  "$schema": "https://opencode.ai/config.json",

  // Free model available on a fresh OpenCode install. Switch to an OmniRoute
  // route such as "omniroute/auto" after configuring OmniRoute.
  "model": "opencode/big-pickle",

  "plugins": [
    // DCP 3.2.x supports the OpenCode V2 plugin API.
    // Ponytail is not a plugin here: opencode-ponytail 4.7.3 is V1-only.
    // Its Lite ruleset lives in the global AGENTS.md.
    "@tarquinen/opencode-dcp@3.2.0"
  ],

  // Bound tool output and compact conservatively.
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 32768
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": "15%"
  },

  // Avoid feeding generated or cached files into context.
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".cache/**"
    ]
  },

  // Ask before privileged or destructive shell commands and outside access.
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ]
}

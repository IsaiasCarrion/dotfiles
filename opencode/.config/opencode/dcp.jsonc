{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",

  "enabled": true,
  // Version is pinned in opencode.jsonc; do not silently update it.
  "autoUpdate": false,
  "debug": false,
  "pruneNotification": "minimal",
  "pruneNotificationType": "chat",

  "commands": {
    "enabled": true,
    "protectedTools": []
  },

  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },

  "turnProtection": {
    "enabled": true,
    "turns": 4
  },

  "experimental": {
    "allowSubAgents": false,
    "customPrompts": false
  },

  // Keep instruction files and secret-bearing environment files verbatim.
  "protectedFilePatterns": [
    "**/AGENTS.md",
    "**/.env",
    "**/.env.*"
  ],

  "compress": {
    "mode": "range",
    "permission": "allow",
    "showCompression": false,
    "summaryBuffer": true,
    "maxContextLimit": "75%",
    "minContextLimit": "35%",
    "nudgeFrequency": 8,
    "iterationNudgeThreshold": 20,
    "nudgeForce": "soft",
    "protectedTools": [],
    "protectTags": false,
    "protectUserMessages": false
  },

  "strategies": {
    "deduplication": {
      "enabled": true,
      "protectedTools": []
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4,
      "protectedTools": []
    }
  }
}

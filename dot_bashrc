# Flechas arriba/abajo: buscar historial que empieza con lo ya escrito.
__history_search_up() {
    local line="${READLINE_LINE}"
    local point="${READLINE_POINT}"
    history -n
    READLINE_LINE=$(HISTTIMEFORMAT= builtin history | sed 's/^[[:space:]]*[0-9]*[[:space:]]*//' |
        awk -v prefix="$line" 'index($0, prefix) == 1 { result=$0 } END { if (result != "") print result }')
    READLINE_POINT=${#READLINE_LINE}
}
# La búsqueda incremental del historial la proporciona fzf con Ctrl+R.
# Ctrl+G busca directorios con la función zzf (definida más abajo).

zzf() {
    command -v zoxide >/dev/null 2>&1 || { echo "zoxide no está instalado."; return 127; }
    command -v fzf >/dev/null 2>&1 || { echo "fzf no está instalado."; return 127; }

    local selected dir
    selected=$(
        zoxide query -ls |
            fzf --height=50% --layout=reverse --border --prompt='📁 Directorio > ' \
                --preview='eza --icons --tree --level=2 --color=always {2..} 2>/dev/null || ls -la {2..} 2>/dev/null'
    ) || return

    [[ -n "$selected" ]] || return 0
    dir="${selected#* }"
    [[ -d "$dir" ]] && cd -- "$dir"
}

bind 'set completion-ignore-case on'
bind 'set completion-map-case on'

# Ctrl+G ejecuta zzf en Bash interactivo.
bind -x '"\C-g": zzf'

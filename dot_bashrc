# ==============================================================================
# PACKAGE HELPERS — CACHYOS / PACMAN
# ==============================================================================

# Navegador de paquetes de repositorios CachyOS.
pacs() {
    command -v fzf >/dev/null 2>&1 || { echo "Instalá fzf."; return 127; }
    command -v pacman-conf >/dev/null 2>&1 || { echo "No se encontró pacman-conf."; return 127; }

    local -a repos
    local pkg
    mapfile -t repos < <(pacman-conf --repo-list | grep '^cachyos')

    ((${#repos[@]} > 0)) || { echo "No se encontraron repositorios CachyOS."; return 1; }

    pkg=$(
        pacman -Slq "${repos[@]}" | sort -u |
            fzf --multi --height=80% --layout=reverse --border \
                --prompt='📦 CachyOS > ' \
                --preview='pacman -Si {} 2>/dev/null; echo; echo "────────────"; pacman -Fl {} 2>/dev/null | head -200' \
                --preview-window=right:70%
    ) || return

    [[ -n "$pkg" ]] || return 0
    local -a packages
    mapfile -t packages <<< "$pkg"
    sudo pacman -S -- "${packages[@]}"
}

# Elegir paquetes instalados y eliminarlos tras confirmación.
pacrm() {
    command -v fzf >/dev/null 2>&1 || { echo "Instalá fzf."; return 127; }

    local pkgs answer
    local -a packages
    pkgs=$(
        pacman -Qq |
            fzf --multi --height=80% --layout=reverse --border \
                --prompt='🗑️ Remove > ' \
                --preview='pacman -Qi {} 2>/dev/null; echo; echo "────────────"; pactree -r {} 2>/dev/null | head -50' \
                --preview-window=right:70%
    ) || return

    [[ -n "$pkgs" ]] || return 0
    echo
    printf 'Paquetes seleccionados:\n%s\n\n' "$pkgs"
    read -r -p "¿Eliminar los paquetes seleccionados? [y/N]: " answer
    [[ "$answer" =~ ^[Yy]$ ]] || { echo "Operación cancelada."; return 0; }

    mapfile -t packages <<< "$pkgs"
    sudo pacman -Rns -- "${packages[@]}"
}

# ==============================================================================
# PYTHON PACKAGE BROWSER — PYPI
# ==============================================================================

pypacs() {
    command -v fzf >/dev/null 2>&1 || { echo "Instalá fzf."; return 127; }
    command -v curl >/dev/null 2>&1 || { echo "Instalá curl."; return 127; }
    command -v jq >/dev/null 2>&1 || { echo "Instalá jq."; return 127; }

    local pkg
    pkg=$(
        curl -fsSL https://pypi.org/simple/ |
            sed -E 's/<[^>]+>//g' |
            sed '/^[[:space:]]*$/d' |
            fzf --height=80% --layout=reverse --border --prompt='🐍 PyPI > ' \
                --preview='curl -fsSL "https://pypi.org/pypi/{}/json" | jq -r ".info.name, \"\", \"Version: \\(.info.version)\", \"\", .info.summary, \"\", \"Home: \\(.info.home_page)\", \"\", .info.author"' \
                --preview-window=right:60%
    ) || return

    [[ -n "$pkg" ]] || return 0
    echo "Paquete seleccionado: $pkg"

    if command -v uv >/dev/null 2>&1; then
        if [[ -n "${VIRTUAL_ENV:-}" ]]; then
            uv pip install "$pkg"
        else
            echo "Activá primero un entorno virtual con v, o usá uv tool para herramientas CLI."
            return 1
        fi
    else
        echo "Recomendación: instalá uv y activá un entorno virtual antes de instalar paquetes."
        return 127
    fi
}

